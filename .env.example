# ==============================================================================
# Lakhera Enterprise Environment Configuration
# ==============================================================================

# GEMINI_API_KEY: Supports Google Gemini AI (Free-Tier API key compatible).
# Uses model 'gemini-2.5-flash' with built-in rate-limit resilience and verified fallback.
# For Netlify Functions, add GEMINI_API_KEY to your Netlify Site Environment Variables.
# For client-side Vite builds, you can also optionally define VITE_GEMINI_API_KEY.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MAPS API KEY: NONE REQUIRED!
# Lakhera Enterprise utilizes direct zero-key Google Maps embeds and direct GPS directions.
# No Google Maps API key or billing configuration is required.

# SUPABASE_URL: The URL of your Supabase database instance.
